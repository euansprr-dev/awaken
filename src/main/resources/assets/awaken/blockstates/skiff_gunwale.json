{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "awaken:block/skiff_gunwale"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "awaken:block/skiff_gunwale",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "awaken:block/skiff_gunwale",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "awaken:block/skiff_gunwale",
        "y": 270
      }
    }
  ]
}
