#version 450
// Turbo demo: a 256 x 256 grid built on the GPU every frame. Each invocation writes one vertex (camera-relative
// position + RGBA, the POSITION_COLOR layout) and, when its quad is kept, appends the quad's six indices and bumps
// the indexed-indirect draw's index count, so the GPU decides what gets drawn.
layout(local_size_x = 16, local_size_y = 16) in;

const uint N = 256u;

struct Vertex { float x, y, z; uint rgba; };
layout(std430, binding = 0) writeonly buffer Vertices { Vertex verts[]; };
layout(std430, binding = 1) writeonly buffer Indices { uint idx[]; };
layout(std430, binding = 2) buffer Args { uint indexCount; uint instanceCount; uint firstIndex; int vertexOffset; uint firstInstance; } args;
layout(push_constant) uniform Push { vec3 offset; float time; } pc;

float height(vec2 p) {
    return 6.0 * sin(p.x * 0.07 + pc.time * 0.9) * cos(p.y * 0.05 - pc.time * 0.6)
         + 2.5 * sin(length(p - vec2(128.0)) * 0.18 - pc.time * 2.0);
}

uint rgba(vec3 c) {
    uvec3 u = uvec3(clamp(c, 0.0, 1.0) * 255.0 + 0.5);
    return u.r | (u.g << 8) | (u.b << 16) | (255u << 24);
}

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= N || id.y >= N) return;
    vec2 p = vec2(id);
    float h = height(p);
    float t = clamp(h / 17.0 + 0.5, 0.0, 1.0);
    vec3 low = vec3(0.10, 0.22, 0.55), high = vec3(0.55, 0.95, 1.00);
    uint i = id.y * N + id.x;
    verts[i] = Vertex(pc.offset.x + p.x, pc.offset.y + h, pc.offset.z + p.y, rgba(mix(low, high, t)));
    if (id.x == N - 1u || id.y == N - 1u) return;
    // a ring that sweeps outwards stays empty: the drawn count changes every frame, decided here
    float r = length(p - vec2(127.5));
    if (abs(r - mod(pc.time * 24.0, 180.0)) < 6.0) return;
    uint base = atomicAdd(args.indexCount, 6u);
    idx[base] = i;
    idx[base + 1u] = i + N;
    idx[base + 2u] = i + 1u;
    idx[base + 3u] = i + 1u;
    idx[base + 4u] = i + N;
    idx[base + 5u] = i + N + 1u;
}
