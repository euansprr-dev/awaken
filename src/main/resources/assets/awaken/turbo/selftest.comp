#version 450
// Turbo's probe: every invocation writes a value the CPU can predict (Turbo.selfTest checks all of them).
layout(local_size_x = 64) in;
layout(std430, binding = 0) writeonly buffer Out { uint v[]; };
layout(push_constant) uniform Push { uint seed; uint count; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) v[i] = (i * 2654435761u) ^ pc.seed;
}
