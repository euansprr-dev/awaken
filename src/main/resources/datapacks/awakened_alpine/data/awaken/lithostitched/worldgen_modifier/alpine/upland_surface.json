{
  "type": "lithostitched:set_material_rule",
  "target_rules": "minecraft:overworld/biome_surface",
  "injection_type": "prepend",
  "material_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": "#awaken:upland"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:y_above",
        "anchor": {
          "absolute": 150
        },
        "surface_depth_multiplier": 0,
        "add_stone_depth": false
      },
      "then_run": "awaken:alpine/surface"
    }
  }
}
