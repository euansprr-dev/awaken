{
  "type": "lithostitched:set_material_rule",
  "target_rules": "minecraft:overworld/under_biome_surface",
  "injection_type": "prepend",
  "material_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": "awaken:mirror_marsh"
    },
    "then_run": "awaken:lands/mirror_marsh_under"
  }
}
