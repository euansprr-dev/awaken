{
  "type": "minecraft:condition",
  "if_true": "minecraft:on_floor",
  "then_run": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:y_above",
          "add_stone_depth": false,
          "anchor": {
            "absolute": 62
          },
          "surface_depth_multiplier": 0
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:not",
            "invert": {
              "type": "minecraft:y_above",
              "add_stone_depth": false,
              "anchor": {
                "absolute": 63
              },
              "surface_depth_multiplier": 0
            }
          },
          "then_run": {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "noise": "minecraft:surface_swamp",
              "min_threshold": -0.2,
              "max_threshold": 1.7976931348623157e+308
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": "minecraft:water"
            }
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": "minecraft:not_underwater",
        "then_run": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:noise_threshold",
                "noise": "awaken:lands/peat",
                "min_threshold": -0.45,
                "max_threshold": 1.7976931348623157e+308
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": "awaken:mirepeat"
              }
            },
            {
              "type": "minecraft:block",
              "result_state": "minecraft:grass_block"
            }
          ]
        }
      },
      {
        "type": "minecraft:block",
        "result_state": "awaken:mirepeat"
      }
    ]
  }
}
